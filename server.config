[server]
# API server settings
host = "0.0.0.0"
port = 7523
web_port = 8085
max_connections = 1000
request_timeout = 30
debug_logging = false

[features]
chat_enabled = true
file_uploads_enabled = true
project_creation_enabled = true
cli_distribution_enabled = true
oauth_enabled = true
websocket_sync_enabled = true

[auth]
whitelist_enabled = true
whitelist_path = "whitelist.config"
require_auth = true
token_expiration_days = 30
max_login_attempts = 5
ban_duration_minutes = 15

[collaboration]
max_users_per_rift = 50
max_chat_message_length = 1000
store_chat_history = true
max_chat_history = 1000
presence_enabled = true
presence_update_interval = 30

[cli_distribution]
require_auth_for_downloads = true
binaries_path = "cli-binaries"
max_downloads_per_hour = 100
track_downloads = true 

[streaming]
enabled = true                 # Enable file streaming support
threshold = 10485760           # File size threshold for streaming (10 MB)
chunk_size = 65536             # Chunk size for streaming (64 KB)
max_concurrent_streams = 4      # Maximum concurrent file streams
timeout_seconds = 300          # Stream timeout in seconds
enable_compression = true      # Compress streamed data
compression_level = 6          # Compression level (0-9)