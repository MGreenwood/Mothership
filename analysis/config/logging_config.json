{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "standard": {
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "detailed": {
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(filename)s:%(lineno)d - %(funcName)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "json": {
      "format": "{\"timestamp\": \"%(asctime)s\", \"logger\": \"%(name)s\", \"level\": \"%(levelname)s\", \"message\": \"%(message)s\", \"file\": \"%(filename)s\", \"line\": %(lineno)d}",
      "datefmt": "%Y-%m-%dT%H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "standard",
      "stream": "ext://sys.stdout"
    },
    "file": {
      "class": "logging.FileHandler",
      "level": "DEBUG",
      "formatter": "detailed",
      "filename": "../logs/analysis.log",
      "mode": "a"
    },
    "error_file": {
      "class": "logging.FileHandler",
      "level": "ERROR",
      "formatter": "detailed",
      "filename": "../logs/error.log",
      "mode": "a"
    },
    "evidence_file": {
      "class": "logging.FileHandler",
      "level": "INFO",
      "formatter": "json",
      "filename": "../logs/evidence.log",
      "mode": "a"
    }
  },
  "loggers": {
    "analysis": {
      "level": "DEBUG",
      "handlers": ["console", "file"],
      "propagate": false
    },
    "code_analysis": {
      "level": "DEBUG", 
      "handlers": ["file"],
      "propagate": false
    },
    "functional_tests": {
      "level": "DEBUG",
      "handlers": ["file"],
      "propagate": false
    },
    "integration_tests": {
      "level": "DEBUG",
      "handlers": ["file"],
      "propagate": false
    },
    "evidence": {
      "level": "INFO",
      "handlers": ["evidence_file"],
      "propagate": false
    },
    "errors": {
      "level": "ERROR",
      "handlers": ["console", "error_file"],
      "propagate": false
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["console", "file"]
  }
}